# Copie este arquivo para ".env" e preencha. NUNCA publique o .env.

# Endereço público do sistema, SEM barra no final (use https em produção)
BASE_URL=https://sistema.suaempresa.com.br
PORT=3000

# Texto longo e aleatório (32+ caracteres). Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Login Microsoft (veja o README, passo 2)
AUTH_MODE=microsoft
MS_CLIENT_ID=
MS_CLIENT_SECRET=
VICTA_TENANT_ID=
# Deixe vazio se a Diagonal não usar Microsoft 365 (nesse caso os e-mails @diagonalinc.com.br não conseguem entrar)
DIAGONAL_TENANT_ID=

# Onde ficam as solicitações (use um disco que NÃO seja apagado ao reiniciar)
# DATA_DIR=/var/lib/sistema-mudanca
